@model ContactInfo

<div class="container">
    <h2>Contact Details</h2>
    @if (Model != null)
    {
        <div class="card mt-3">
            <div class="card-body">
                <h5 class="card-title">@Model.FirstName @Model.LastName</h5>
                <p><strong>ID:</strong> @Model.ContactId</p>
                <p><strong>Company:</strong> @Model.CompanyName</p>
                <p><strong>Email:</strong> @Model.EmailId</p>
                <p><strong>Mobile:</strong> @Model.MobileNo</p>
                <p><strong>Designation:</strong> @Model.Designation</p>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger mt-3">Contact not found!</div>
    }
    <a asp-action="ShowContacts" class="btn btn-primary mt-3">Back to List</a>
</div>
