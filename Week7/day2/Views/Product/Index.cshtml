@{
    ViewData["Title"] = "Inventory Management";
}

<div class="container mt-5">
    <h2>Add New Product</h2>
   
    <form action="/inventory/add" method="post" class="card p-4 shadow-sm">
        <div class="row">
            <div class="col-md-4">
                <label>Product Name</label>
                <input type="text" name="productName" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label>Price</label>
                <input type="number" step="0.01" name="price" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label>Quantity</label>
                <input type="number" name="quantity" class="form-control" required />
            </div>
            <div class="col-md-2">
                <label>&nbsp;</label>
                <button type="submit" class="btn btn-primary w-100">Add to List</button>
            </div>
        </div>
    </form>

    <hr class="my-5" />

    <h3>Stored Products</h3>
    <table class="table table-hover table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total Value</th>
            </tr>
        </thead>
        <tbody>
            @if (ViewBag.AllProducts != null)
            {
                foreach (var item in ViewBag.AllProducts)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Price</td>
                        @* FIX 2: Use .Quantity to match the Controller *@
                        <td>@item.Quantity</td>
                        <td>@item.Total</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
