@model ContactManagementWebApplication.Models.ContactInfo

<h2>Contact Details</h2>
<div>
    <p><strong>Full Name:</strong> @Model.FirstName @Model.LastName</p>
    <p><strong>Designation:</strong> @Model.Designation</p>
