@model IEnumerable<ContactManagementWebApplication.Models.ContactInfo>

<h2>All Contacts</h2>
<a asp-action="AddContact" class="btn btn-primary mb-3">Add New Contact</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Company</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ContactId</td>
                <td>@item.FirstName @item.LastName</td>
                <td>@item.CompanyName</td>
                <td>@item.EmailId</td>
                <td><a asp-action="GetContactById" asp-route-id="@item.ContactId">Details</a></td>
            </tr>
        }
    </tbody>
</table>
