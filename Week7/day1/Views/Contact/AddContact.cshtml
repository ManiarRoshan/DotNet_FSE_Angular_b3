@model ContactManagementWebApplication.Models.ContactInfo

<h2>Add New Contact</h2>
<form asp-action="AddContact" method="post">
    <div class="form-group">
        <label>Contact ID</label>
        <input asp-for="ContactId" class="form-control" type="number" required />
    </div>
    <div class="form-group">
        <label>First Name</label>
        <input asp-for="FirstName" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Last Name</label>
        <input asp-for="LastName" class="form-control" required />
    </div>
    <div class="form-group">
        <label>company Name</label>
        <input asp-for="CompanyName" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Email</label>
        <input asp-for="EmailId" class="form-control" type="email" required />
    </div>
    <div class="form-group">
        <label>Mobile No</label>
        <input asp-for="MobileNo" class="form-control" type="number" required />
    </div>
    <div class="form-group">
        <label>Designation</label>
        <input asp-for="Designation" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-success mt-2">Save Contact</button>
</form>
 