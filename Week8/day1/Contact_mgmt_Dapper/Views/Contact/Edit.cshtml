@model ContactInfo

<h2>Edit Contact</h2>
<hr />
<form asp-action="Edit">
    <input type="hidden" asp-for="ContactId" />
    
    <div class="form-group mb-2">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="LastName"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="EmailId"></label>
        <input asp-for="EmailId" class="form-control" />
        <span asp-validation-for="EmailId" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="MobileNo"></label>
        <input asp-for="MobileNo" class="form-control" />
        <span asp-validation-for="MobileNo" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label asp-for="Designation"></label>
        <input asp-for="Designation" class="form-control" />
        <span asp-validation-for="Designation" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label>Company</label>
        <select asp-for="CompanyId" class="form-control" asp-items="ViewBag.Companies"></select>
        <span asp-validation-for="CompanyId" class="text-danger"></span>
    </div>

    <div class="form-group mb-2">
        <label>Department</label>
        <select asp-for="DepartmentId" class="form-control" asp-items="ViewBag.Departments"></select>
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>

    <div class="mt-3">
        <input type="submit" value="Update" class="btn btn-warning" />
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
