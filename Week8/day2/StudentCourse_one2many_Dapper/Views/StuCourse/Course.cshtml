@model IEnumerable<StudentCourse_one2many_Dapper.Models.Course>

<table class="table">

    <tr>
        <th>Course Id</th>
        <th>Course Name</th>
        <th>Students</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.CourseId</td>
            <td>@item.CourseName</td>
            <td>
                @if (item.Students.Any())
                {
                    <ul>
                        @foreach (var student in item.Students)
                        {
                            <li>@student.StudentName</li>
                        }
                    </ul>
                }
                else
                {
                    <span>No students enrolled</span>
                }
            </td>
        </tr>
    }

</table>
